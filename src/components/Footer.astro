---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Bio & Mission -->
      <div class="md:col-span-2 space-y-3">
        <span class="text-base font-bold tracking-tight text-slate-900 dark:text-white">
          LEOW KAH MAN
        </span>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          Engineering leader and software architect with over two decades of engineering experience. Championing an AI-first development philosophy, pragmatic systems architecture, and resilient execution.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3">
          Navigation
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Home</a></li>
          <li><a href="/about/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">About</a></li>
          <li><a href="/privacy-policy/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/rss.xml" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">RSS Feed</a></li>
        </ul>
      </div>

      <!-- Col 3: Connect -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3">
          Connect
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a
              href="https://www.linkedin.com/in/kmleow"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-1.5 hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium text-slate-800 dark:text-slate-200"
            >
              <svg class="w-4 h-4 fill-current text-blue-600" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/kmleow"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-1.5 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 space-y-3 text-sm text-slate-600 dark:text-slate-400">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
        <p class="font-medium text-slate-800 dark:text-slate-200">
          &copy; {currentYear} Leow Kah Man.
        </p>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          Content licensed under CC BY-SA 4.0; code samples under MIT.
        </p>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-900 pt-3">
        <span class="font-semibold text-slate-700 dark:text-slate-300">Disclaimer:</span> All publications, writeups, and architectural analyses across this site are solely my personal expression and do not represent the views, positions, or strategies of my current or past employers.
      </p>
    </div>
  </div>
</footer>
