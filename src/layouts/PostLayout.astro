---
import BaseLayout from './BaseLayout.astro';
import AdSense from '../components/AdSense.astro';

interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      heroImage: string;
      heroAlt: string;
      category: string;
      tags: string[];
      author: string;
    };
    body?: string;
  };
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, category, tags, author } = post.data;

const formattedPubDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDate)
  : null;

// Estimate reading time
const wordCount = post.body ? post.body.split(/\s+/).length : 600;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const articleData = {
  headline: title,
  publishedTime: pubDate.toISOString(),
  modifiedTime: updatedDate ? updatedDate.toISOString() : undefined,
  author: author,
  tags: tags,
  category: category,
  wordCount: wordCount,
};
---

<BaseLayout
  title={`${title} | Leow Kah Man`}
  description={description}
  image={heroImage}
  imageAlt={heroAlt}
  pageType="article"
  article={articleData}
>
  <article class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-medium">
      <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-300">{category}</span>
    </nav>

    <!-- Header Meta -->
    <header class="mb-8 sm:mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="inline-flex items-center px-3 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300 border border-brand-200/60 dark:border-brand-800/60">
          {category}
        </span>
        <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
          &bull; {readingMinutes} min read
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight mb-5">
        {title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal mb-6">
        {description}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 py-3 border-y border-slate-200/80 dark:border-slate-800/80 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <div>
          Published <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          {formattedUpdatedDate && (
            <span> &bull; Updated <time datetime={updatedDate?.toISOString()}>{formattedUpdatedDate}</time></span>
          )}
        </div>
        <div>
          {readingMinutes} min read
        </div>
      </div>
    </header>

    <!-- Hero Image Region -->
    <div class="mb-10 overflow-hidden rounded-2xl bg-[#FAF7F2] dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm aspect-[16/9]">
      <img
        src={heroImage}
        alt={heroAlt}
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Article Body -->
    <div class="prose-tech">
      <slot />
    </div>

    <!-- Dynamic Content-Length-Aware In-Article AdSense Inserter -->
    <script is:inline>
      (function () {
        const article = document.querySelector('.prose-tech');
        if (!article) return;

        const children = Array.from(article.children);
        const text = article.innerText || '';
        const words = text.trim().split(/\s+/).length;

        // Content Length Tiers for Policy-Compliant Ad Density:
        // Tier 1: Short posts (<600 words) -> 0 mid-article ads (only bottom ad renders).
        // Tier 2: Standard posts (600 - 1400 words) -> 1 mid-article ad at ~40% depth.
        // Tier 3: Long deep-dives (>1400 words) -> 2 mid-article ads (at ~35% and ~70% depth).

        const insertAd = function (targetIndex, slotId) {
          if (targetIndex <= 0 || targetIndex >= children.length) return;
          const targetEl = children[targetIndex];

          const wrapper = document.createElement('div');
          wrapper.className = 'adsense-wrapper my-10 text-center overflow-hidden not-prose';
          wrapper.innerHTML = `
            <div class="text-[10px] uppercase tracking-wider text-slate-400 dark:text-slate-500 font-medium mb-1.5">Advertisement</div>
            <div class="ad-container min-h-[90px] flex items-center justify-center bg-slate-100/50 dark:bg-slate-900/30 border border-dashed border-slate-200 dark:border-slate-800 rounded-lg p-2">
              <ins class="adsbygoogle"
                   style="display:block; text-align:center;"
                   data-ad-layout="in-article"
                   data-ad-format="fluid"
                   data-ad-client="ca-pub-8585963436723502"
                   data-ad-slot="${slotId}"></ins>
            </div>
          `;

          targetEl.parentNode.insertBefore(wrapper, targetEl);

          if (window.location.hostname === 'www.leowkahman.com' || window.location.hostname === 'leowkahman.com') {
            try {
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            } catch (e) {}
          }
        };

        const findSafeIndex = function (ratio) {
          const target = Math.floor(children.length * ratio);
          for (let i = target; i < children.length - 2; i++) {
            const tag = children[i].tagName.toLowerCase();
            if (tag === 'h2' || tag === 'h3') return i;
          }
          for (let i = target; i > 2; i--) {
            const tag = children[i].tagName.toLowerCase();
            if (tag === 'p') return i + 1;
          }
          return target;
        };

        if (words >= 1400 && children.length >= 12) {
          const idx2 = findSafeIndex(0.7);
          insertAd(idx2, 'article-mid-2');
          const idx1 = findSafeIndex(0.35);
          insertAd(idx1, 'article-mid-1');
        } else if (words >= 600 && children.length >= 6) {
          const idx = findSafeIndex(0.4);
          insertAd(idx, 'article-mid-1');
        }
      })();
    </script>

    <!-- Compliant Bottom-of-Article AdSense Unit -->
    <AdSense slot="article-bottom" className="my-12" />

    <!-- Tags Region -->
    {tags.length > 0 && (
      <div class="my-10 pt-6 border-t border-slate-200 dark:border-slate-800">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">
          Topics &amp; Technologies
        </h4>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="inline-flex items-center px-3 py-1 rounded-md text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    )}
  </article>
</BaseLayout>
