---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  pageType?: 'website' | 'article' | 'profile';
  article?: {
    headline?: string;
    publishedTime: string;
    modifiedTime?: string;
    author: string;
    tags: string[];
    category: string;
    wordCount?: number;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title = 'Leow Kah Man | Engineering Leadership & Systems Tech Blog',
  description = 'Engineering leadership, scalable distributed systems, resilient cloud infrastructure, and software craftsmanship by Leow Kah Man.',
  image = '/favicon-192x192.png',
  imageAlt = 'Leow Kah Man Tech Blog',
  pageType = 'website',
  article,
  breadcrumbs,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://www.leowkahman.com';
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = `${siteUrl}${pathname}`;
const absoluteImageUrl = image.startsWith('http')
  ? image
  : `${siteUrl}${image.startsWith('/') ? image : `/${image}`}`;

// Clean headline for structured data (without branding suffix)
const cleanHeadline = article?.headline || title.replace(/\s*\|\s*Leow Kah Man.*$/, '').trim();

// Build JSON-LD structured data graph
const jsonLdGraph: any[] = [];

if (article) {
  jsonLdGraph.push({
    '@context': 'https://schema.org',
    '@type': ['TechArticle', 'BlogPosting'],
    headline: cleanHeadline,
    description: description,
    image: [absoluteImageUrl],
    datePublished: article.publishedTime,
    dateModified: article.modifiedTime || article.publishedTime,
    inLanguage: 'en',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    author: [
      {
        '@type': 'Person',
        name: article.author || 'Leow Kah Man',
        url: `${siteUrl}/about/`,
        sameAs: [
          'https://www.linkedin.com/in/kmleow',
          'https://github.com/kmleow',
        ],
      },
    ],
    publisher: {
      '@type': 'Person',
      name: 'Leow Kah Man',
      url: `${siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/favicon-192x192.png`,
        width: 192,
        height: 192,
      },
    },
    articleSection: article.category,
    keywords: article.tags?.join(', '),
    ...(article.wordCount ? { wordCount: article.wordCount } : {}),
  });

  // Breadcrumbs schema for Google Search rich navigation trails
  const breadcrumbElements = [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: article.category,
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: cleanHeadline,
      item: canonicalUrl,
    },
  ];

  jsonLdGraph.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbElements,
  });
} else if (pageType === 'profile') {
  jsonLdGraph.push({
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      name: 'Leow Kah Man',
      alternateName: 'KM Leow',
      url: canonicalUrl,
      image: `${siteUrl}/favicon-512x512.png`,
      description: description,
      jobTitle: 'Head of Engineering & Software Architect',
      sameAs: [
        'https://www.linkedin.com/in/kmleow',
        'https://github.com/kmleow',
      ],
    },
  });
} else {
  jsonLdGraph.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Leow Kah Man - Tech Blog',
    url: `${siteUrl}/`,
    description: description,
    inLanguage: 'en',
    author: {
      '@type': 'Person',
      name: 'Leow Kah Man',
      url: `${siteUrl}/about/`,
    },
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Search & Crawler Directives (max-image-preview:large enables rich Discover & search cards) -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Security Meta Directives -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- Framebusting / Anti-Clickjack Protection -->
    <script is:inline>
      if (top !== self) {
        top.location.replace(self.location.href);
      }
    </script>

    <!-- Search Engine Verifications (Preserved from legacy blog) -->
    <meta name="google-site-verification" content="in8GfCIv-CYlwD5AxO0jVMlrUy1s42a_-cxlOWdv4U0" />
    <meta name="msvalidate.01" content="009F12474AB330989749B979B5868A7F" />
    <meta name="yandex-verification" content="c29e9c1084b24e1d" />

    <!-- Favicons & App Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- RSS Syndication -->
    <link rel="alternate" type="application/rss+xml" title="Leow Kah Man - Tech Blog" href="/rss.xml" />

    <!-- Open Graph & Social Cards -->
    <meta property="og:site_name" content="Leow Kah Man" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:secure_url" content={absoluteImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}

    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        <meta property="article:author" content={article.author} />
        <meta property="article:section" content={article.category} />
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <!-- Google AdSense Auto Ads -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8585963436723502"
      crossorigin="anonymous"
    ></script>

    <!-- Structured Data JSON-LD (Search Rich Results, TechArticle, ProfilePage, BreadcrumbList) -->
    {jsonLdGraph.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Google Analytics 4 -->
    <Analytics />
  </head>
  <body class="min-h-dvh flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100">
    <Header />
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
