---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import AdSense from '../components/AdSense.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Sort newest to oldest
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1);
---

<BaseLayout
  title="Leow Kah Man | Engineering Leadership & Architecture"
  description="Executive perspectives on scalable systems, resilient infrastructure, edge security, and disciplined software craftsmanship by Leow Kah Man."
>
  <div class="space-y-12">
    <!-- Publication Hero Header -->
    <section class="border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
          Engineering Leadership &amp; Architecture
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Architectural deep-dives into scalable systems, resilient infrastructure, edge security, and pragmatic software craftsmanship.
        </p>
      </div>
    </section>

    <!-- Lead Story (Featured Card) -->
    {featuredPost && (
      <section aria-label="Lead Story">
        <PostCard post={featuredPost} featured={true} />
      </section>
    )}

    <!-- In-Feed AdSense Placement -->
    <AdSense slot="home-feed" className="my-8" />

    <!-- Secondary Stories Grid -->
    {secondaryPosts.length > 0 && (
      <section aria-label="Recent Articles" class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
            Latest Publications
          </h2>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
            {posts.length} Flagship Articles
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {secondaryPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
