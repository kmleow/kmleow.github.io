---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Sort newest to oldest
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1);
---

<BaseLayout
  title="Leow Kah Man | Engineering Leadership & Architecture"
  description="Executive perspectives on scalable systems, resilient infrastructure, edge security, and disciplined software craftsmanship by Leow Kah Man."
>
  <div class="space-y-12">
    <!-- Lead Story (Featured Card) -->
    {featuredPost && (
      <section aria-label="Lead Story">
        <PostCard post={featuredPost} featured={true} />
      </section>
    )}

    <!-- Secondary Stories Grid -->
    {secondaryPosts.length > 0 && (
      <section aria-label="Recent Articles" class="space-y-6">
        <div class="pb-3 border-b border-slate-200 dark:border-slate-800">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
            Latest Publications
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {secondaryPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
